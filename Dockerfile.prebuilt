# Frontend image built from an already-compiled Next.js standalone bundle.
#
# Unlike ./Dockerfile this does no dependency resolution and touches the network
# zero times, so it works on a slow or offline connection. The trade-off is that
# it is not self-contained: run `npm run build` on the host first, so that
# .next/standalone and .next/static exist.
#
# The standalone output ships both the musl and glibc builds of sharp, so alpine
# is safe here even though the bundle was compiled on a glibc host.
#
# Usage: docker compose build frontend   (docker-compose.override.yml selects this file)
# To go back to the hermetic build, delete or rename docker-compose.override.yml.

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is emitted by `next build` when output: 'standalone' is set.
CMD ["node", "server.js"]
